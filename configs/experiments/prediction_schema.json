{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HAI-ReDeR Prediction Row",
  "type": "object",
  "required": [
    "pair_id",
    "repo",
    "window",
    "split",
    "gold_label",
    "predicted_label",
    "confidence",
    "method"
  ],
  "properties": {
    "pair_id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "type": "string",
      "minLength": 1
    },
    "gold_label": {
      "type": "string",
      "enum": [
        "None",
        "General Relation",
        "Duplication",
        "Composition",
        "Temporal/Causal",
        "Workflow"
      ]
    },
    "predicted_label": {
      "type": "string",
      "enum": [
        "None",
        "General Relation",
        "Duplication",
        "Composition",
        "Temporal/Causal",
        "Workflow"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "probabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "issue_i": {
      "type": "object"
    },
    "issue_j": {
      "type": "object"
    },
    "raw_output": {},
    "parsed_output": {},
    "error": {}
  },
  "additionalProperties": true
}
